#!/bin/bash

case "$(uname -s)" in
    Linux*)     OS="linux";;
    Darwin*)    OS="darwin";;
    CYGWIN*|MINGW*|MSYS*) OS="windows";;
    *)          OS="unknown";;
esac

# detect architecture
case "$(uname -m)" in
    x86_64)    ARCH="amd64";;
    aarch64)   ARCH="arm64";;
    arm64)     ARCH="arm64";;
    *)         ARCH="unknown";;
esac

REPO="kahnwong/swissknife"
GITHUB="https://api.github.com"
VERSION=`
  curl --silent "${GITHUB}/repos/{$REPO}/releases/latest" |
      grep '"tag_name":' |
      sed -E 's/.*"([^"]+)".*/\1/'
`
VERSION_BINARY=$(echo "${VERSION}" | sed 's/^v//')
BINARY_NAME="swissknife"
FILE="${BINARY_NAME}_${VERSION_BINARY}_${OS}_${ARCH}.tar.gz"

# create an isolated extraction directory under /tmp
TEMP_DIR=$(mktemp -d /tmp/swissknife.XXXXXX) || exit 1
trap 'rm -rf "$TEMP_DIR"' EXIT

# download
curl -L -s -o "${TEMP_DIR}/${FILE}" "https://github.com/${REPO}/releases/download/${VERSION}/${FILE}"

# extract
echo "Extracting ${FILE}..."
if ! tar -xzvf "${TEMP_DIR}/${FILE}" -C "$TEMP_DIR"; then
    echo "Error: Failed to extract ${FILE}."
    exit 1
fi

# move binary to the current directory
mv "${TEMP_DIR}/${BINARY_NAME}" ./ || exit 1

# success message
echo "Successfully downloaded and extracted ${FILE}."
